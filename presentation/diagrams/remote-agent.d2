direction: right
user: "User" {class: control}
ssh: "SSH host" {
  class: boundary
  icon: https://deck-icons.invalid/linux.svg
  agent: "Full agent" {
    class: target
    width: 200
    height: 70
    icon: https://deck-icons.invalid/codex.svg
    icon.near: center-left
    label.near: center-center
  }
}
docker: "Docker container" {
  class: boundary
  icon: https://deck-icons.invalid/docker.svg
  agent: "Full agent" {
    class: target
    width: 200
    height: 70
    icon: https://deck-icons.invalid/codex.svg
    icon.near: center-left
    label.near: center-center
  }
}
wsl: "WSL environment" {
  class: boundary
  icon: https://deck-icons.invalid/wsl.svg
  agent: "Full agent" {
    class: target
    width: 200
    height: 70
    icon: https://deck-icons.invalid/codex.svg
    icon.near: center-left
    label.near: center-center
  }
}
api: "Model API" {class: control}
user -> ssh.agent {class: transport}
user -> docker.agent {class: transport}
user -> wsl.agent {class: transport}
ssh.agent -> api {class: transport; style.stroke-dash: 4}
docker.agent -> api {class: transport; style.stroke-dash: 4}
wsl.agent -> api {class: transport; style.stroke-dash: 4}
