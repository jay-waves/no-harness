classes: {
  boundary: {
    style: {fill: "#ffffff"; stroke: "#@grey"; stroke-width: 1; font-color: "#@indigo"; font-size: 21}
  }
  control: {
    style: {fill: "#ffffff"; stroke: "#@indigo"; stroke-width: 2; border-radius: 6; font-color: "#@indigo"; font-size: 21}
  }
  target: {
    style: {fill: "#ffffff"; stroke: "#@teal"; stroke-width: 2; border-radius: 6; font-color: "#202020"; font-size: 20}
  }
  transport: {
    style: {stroke: "#@indigo"; stroke-width: 2; font-color: "#@indigo"; font-size: 22}
  }
}
