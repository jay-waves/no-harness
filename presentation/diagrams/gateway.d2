direction: right
robot: "Robot rover" {
  class: edge-device
  icon: https://deck-icons.invalid/rover.svg
}
phone: "Android phone" {
  class: edge-device
  icon: https://deck-icons.invalid/android-phone.svg
}
arduino: "Arduino" {
  class: edge-device
  icon: https://deck-icons.invalid/arduino.svg
}
pi: "Raspberry Pi" {
  class: edge-device
  icon: https://deck-icons.invalid/raspberry-pi.svg
}
gateway: Unified gateway {
  class: control
  grid-columns: 1
  grid-gap: 10
  proxy: Network proxy {
    class: target
    width: 260
    icon: https://deck-icons.invalid/clash-verge.png
    icon.near: center-left
    label.near: center-center
  }
  llm: LLM gateway {class: target}
  logs: Logs {class: target}
}
providers: "LLM providers" {
  class: boundary
  grid-columns: 2
  grid-gap: 10
  codex: Codex {
    class: target
    icon: https://deck-icons.invalid/codex.svg
  }
  claude: Claude Code {
    class: target
    icon: https://deck-icons.invalid/claude-code.png
  }
  qwen: Qwen {
    class: target
    icon: https://deck-icons.invalid/qwen.svg
  }
  deepseek: DeepSeek {
    class: target
    icon: https://deck-icons.invalid/deepseek.png
  }
  gemini: Gemini {
    class: target
    icon: https://deck-icons.invalid/gemini.svg
  }
}
robot -> gateway {class: transport}
phone -> gateway {class: transport}
arduino -> gateway {class: transport}
pi -> gateway {class: transport}
gateway -> providers: M provider APIs {class: transport}
