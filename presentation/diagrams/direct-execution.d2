direction: right
user: User {class: control}
agent: "Local agent\nShared context" {
  class: control
  icon: https://deck-icons.invalid/codex.svg
}
ssh: "SSH host" {
  class: boundary
  icon: https://deck-icons.invalid/linux.svg
  first: "Python command\nNew process" {
    class: target
    width: 255
    height: 64
    icon: https://deck-icons.invalid/python.svg
    icon.near: center-left
    label.near: center-right
  }
  second: "Python command\nNew process" {
    class: target
    width: 255
    height: 64
    icon: https://deck-icons.invalid/python.svg
    icon.near: center-left
    label.near: center-right
  }
  first -> second {class: transport}
}
docker: "Docker container" {
  class: boundary
  icon: https://deck-icons.invalid/docker.svg
  first: "Node.js command\nNew process" {
    class: target
    width: 255
    height: 64
    icon: https://deck-icons.invalid/nodejs.svg
    icon.near: center-left
    label.near: center-right
  }
  second: "Node.js command\nNew process" {
    class: target
    width: 255
    height: 64
    icon: https://deck-icons.invalid/nodejs.svg
    icon.near: center-left
    label.near: center-right
  }
  first -> second {class: transport}
}
wsl: "WSL environment" {
  class: boundary
  icon: https://deck-icons.invalid/wsl.svg
  first: "Shell command\nNew process" {
    class: target
    width: 255
    height: 64
    icon: https://deck-icons.invalid/bash.svg
    icon.near: center-left
    label.near: center-right
  }
  second: "Shell command\nNew process" {
    class: target
    width: 255
    height: 64
    icon: https://deck-icons.invalid/bash.svg
    icon.near: center-left
    label.near: center-right
  }
  first -> second {class: transport}
}
user -> agent {class: transport}
agent -> ssh.first: ssh {class: transport}
agent -> docker.first: docker exec {class: transport}
agent -> wsl.first: wsl --exec {class: transport}
